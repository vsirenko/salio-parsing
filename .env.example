# Note: keep comments on their own lines.
# `docker run --env-file` does not strip trailing `# ...` and would read it as part of the value.

# --- App ---
APP_NAME=Products API
APP_VERSION=0.1.0
# local | dev | staging | production
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# --- HTTP ---
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api

# --- Docs ---
# Set to false in production to hide /docs, /redoc and /openapi.json
DOCS_ENABLED=true

# --- Database ---
# The compose file maps Postgres to 55432 on the host: 5432 is usually taken.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:55432/app
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Auth ---
# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me-before-deploying-anywhere
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Dev-only demo accounts. Startup fails if this is true in production.
SEED_USERS=true

# --- Sign-in rate limit ---
# Failed sign-ins are counted per account and per address; crossing a limit locks
# that bucket, and the lock doubles with every further failure up to the maximum.
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCK_SECONDS=60
LOGIN_MAX_LOCK_SECONDS=3600

# --- Audit ---
# Trust X-Forwarded-For and X-Request-ID from the caller.
# Only enable behind a proxy that rewrites them, otherwise they are spoofable.
TRUST_PROXY_HEADERS=false

# --- CORS ---
# Comma-separated list. Use explicit origins whenever CORS_ALLOW_CREDENTIALS=true.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
