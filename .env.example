# Note: keep comments on their own lines.
# `docker run --env-file` does not strip trailing `# ...` and would read it as part of the value.

# --- App ---
APP_NAME=salio-parsing
APP_VERSION=0.1.0
# local | dev | staging | production
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# --- HTTP ---
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api

# --- Docs ---
# Set to false in production to hide /docs, /redoc and /openapi.json
DOCS_ENABLED=true

# --- Database ---
# The compose file maps Postgres to 55432 on the host: 5432 is usually taken.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:55432/app
# docker-compose.prod.yml builds DATABASE_URL from these and needs the password set.
# On a server: a long random password; nothing outside the compose network reaches it.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# docker-compose.prod.yml binds the api to 127.0.0.1 on this port, for a look from the server.
API_PORT=8080
# The name Caddy serves the api under and takes a certificate for; its DNS must point here.
API_DOMAIN=api.example.com
# The admin panel's name: Caddy serves its build from /srv/salio-admin and its /api on the same
# origin.
ADMIN_DOMAIN=admin.example.com
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Auth ---
# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me-before-deploying-anywhere
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Dev-only demo accounts. Startup fails if this is true in production.
SEED_USERS=true

# --- Sign-in rate limit ---
# Failed sign-ins are counted per account and per address; crossing a limit locks
# that bucket, and the lock doubles with every further failure up to the maximum.
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCK_SECONDS=60
LOGIN_MAX_LOCK_SECONDS=3600

# --- The collector's own account ---
# A worker is not an administrator: it hands over what it crawled and reports how the
# run went, and can do nothing else.
WORKER_EMAIL=worker@example.com
WORKER_PASSWORD=worker-password
# Where a worker reaches the service. Inside compose: http://api:8000
API_BASE_URL=http://localhost:8080

# --- Ingestion ---
# Batches are posted gzipped. The cap is a safety limit against a decompression bomb,
# not a tuning knob.
MAX_DECOMPRESSED_BODY_MB=32
MAX_BATCH_OFFERS=500
# Products a worker reads before handing them over, so a run shows up while it runs.
WORKER_HANDOVER_EVERY=100

# --- Collection scheduler ---
# Runs as its own process: docker compose run --rm scheduler, or the compose service.
SCHEDULER_TICK_SECONDS=20
# How many runs may be going at once. Low on purpose — two concurrent crawls on a small
# box is how the memory limit gets found.
SCHEDULER_MAX_RUNNING=1
RUN_TIMEOUT_MINUTES=60

# --- The judge (TypeSafe) ---
# Judging is off while this is empty; there is no separate on/off flag.
# Get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_SECONDS=10.0
# How many listings are judged in one round trip's worth of time.
JUDGE_CONCURRENCY=4
# Answers below this are recorded but not acted on.
JUDGE_MIN_CONFIDENCE=0.85
# A rule's match is listed for review when the judge gives it less than this
# chance of naming the entry's own model.
JUDGE_DOUBT_BELOW=0.1

# --- Audit ---
# Trust X-Forwarded-For and X-Request-ID from the caller.
# Only enable behind a proxy that rewrites them, otherwise they are spoofable.
TRUST_PROXY_HEADERS=false

# --- CORS ---
# Comma-separated list. Use explicit origins whenever CORS_ALLOW_CREDENTIALS=true.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
